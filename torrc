# Publishes electrs' Electrum RPC port (50001) as a Tor hidden service.
# No local SocksPort: this daemon only publishes the service; clients (e.g.
# Sparrow) run their own Tor to reach it -- see 'bitstack wallet'.
SocksPort 0
RunAsDaemon 0
Log notice stdout

# Started as root (see tor.Dockerfile); Tor itself fixes ownership/perms on
# DataDirectory and HiddenServiceDir before dropping privileges to this user,
# which is what lets HiddenServiceDir live on a plain docker volume (created
# root-owned) without a custom entrypoint script.
User debian-tor

DataDirectory /var/lib/tor
HiddenServiceDir /var/lib/tor/hidden_service/
HiddenServicePort 50001 electrs:50001
